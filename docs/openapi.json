{
    "openapi": "3.0.0",
    "info": {
        "title": "Todo API",
        "description": "Todo application REST API",
        "version": "1.0.0"
    },
    "paths": {
        "/api/v1/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Register a new user",
                "operationId": "post_api_auth_register",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/RegisterDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "User registered",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResponseSchema"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "409": {
                        "description": "Email already taken"
                    }
                },
                "security": []
            }
        },
        "/api/v1/auth/refresh": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Refresh JWT token using refresh token cookie",
                "operationId": "post_api_auth_refresh",
                "parameters": [
                    {
                        "name": "refresh_token",
                        "in": "cookie",
                        "description": "Refresh token cookie (set automatically by login/refresh)",
                        "required": true,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Tokens refreshed \u2014 new access_token and refresh_token cookies set",
                        "headers": {
                            "Set-Cookie": {
                                "description": "Updated access_token and refresh_token HttpOnly cookies",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Invalid or expired refresh token"
                    }
                },
                "security": []
            }
        },
        "/api/v1/auth/logout": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logout \u2014 revoke refresh token and clear cookies",
                "operationId": "post_api_auth_logout",
                "parameters": [
                    {
                        "name": "refresh_token",
                        "in": "cookie",
                        "description": "Refresh token cookie used to revoke the current authenticated session on logout",
                        "required": false,
                        "schema": {
                            "type": "string"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Logged out \u2014 cookies cleared and refresh token revoked when a valid refresh_token cookie is present"
                    }
                }
            }
        },
        "/api/v1/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Login \u2014 sets access_token and refresh_token cookies",
                "operationId": "post_api_auth_login",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "example": "user@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "secret123"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "204": {
                        "description": "Authenticated \u2014 access_token and refresh_token cookies set, empty response body",
                        "headers": {
                            "Set-Cookie": {
                                "description": "access_token and refresh_token HttpOnly cookies",
                                "schema": {
                                    "type": "string"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                },
                "security": []
            }
        },
        "/api/v1/profile": {
            "get": {
                "tags": [
                    "Profile"
                ],
                "summary": "Get current authenticated user",
                "operationId": "get_api_profile_me",
                "responses": {
                    "200": {
                        "description": "Current user",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/UserResponseSchema"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            }
        },
        "/api/v1/tasks": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Get all tasks (paginated)",
                "operationId": "get_api_task_get_all",
                "parameters": [
                    {
                        "name": "page",
                        "in": "query",
                        "required": false,
                        "style": "deepObject",
                        "explode": true,
                        "schema": {
                            "properties": {
                                "number": {
                                    "type": "integer",
                                    "default": 1,
                                    "minimum": 1,
                                    "example": 1
                                },
                                "size": {
                                    "type": "integer",
                                    "default": 20,
                                    "maximum": 100,
                                    "minimum": 1,
                                    "example": 20
                                }
                            },
                            "type": "object"
                        }
                    },
                    {
                        "name": "filter",
                        "in": "query",
                        "required": false,
                        "style": "deepObject",
                        "explode": true,
                        "schema": {
                            "properties": {
                                "status": {
                                    "oneOf": [
                                        {
                                            "$ref": "#/components/schemas/TaskStatus"
                                        }
                                    ],
                                    "nullable": true
                                },
                                "due_from": {
                                    "type": "string",
                                    "format": "date",
                                    "example": "2026-04-01",
                                    "nullable": true
                                },
                                "due_to": {
                                    "type": "string",
                                    "format": "date",
                                    "example": "2026-04-30",
                                    "nullable": true
                                }
                            },
                            "type": "object"
                        }
                    },
                    {
                        "name": "sort",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "created_at",
                            "enum": [
                                "created_at",
                                "status",
                                "due_date"
                            ]
                        }
                    },
                    {
                        "name": "direction",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "default": "desc",
                            "enum": [
                                "asc",
                                "desc"
                            ]
                        }
                    },
                    {
                        "name": "search",
                        "in": "query",
                        "description": "Full-text search across task title and description. When provided, results are ranked by relevance.",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "maxLength": 100,
                            "example": "milk",
                            "nullable": true
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Paginated list of tasks",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskCollectionResponseSchema"
                                }
                            }
                        }
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            },
            "post": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Create a task",
                "operationId": "post_api_task_create",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateTaskDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Task created",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskResponseSchema"
                                }
                            }
                        }
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            }
        },
        "/api/v1/tasks/{id}": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Get a task",
                "operationId": "get_api_task_get",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Task details",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskResponseSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Task not found"
                    },
                    "403": {
                        "description": "Access denied"
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            },
            "put": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Update a task",
                "operationId": "put_api_task_update",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateTaskDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Task updated",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskResponseSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Task not found"
                    },
                    "403": {
                        "description": "Access denied"
                    },
                    "422": {
                        "$ref": "#/components/responses/ValidationError"
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            },
            "delete": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Delete a task",
                "operationId": "delete_api_task_delete",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Task deleted"
                    },
                    "404": {
                        "description": "Task not found"
                    },
                    "403": {
                        "description": "Access denied"
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            }
        },
        "/api/v1/tasks/{id}/audit-logs": {
            "get": {
                "tags": [
                    "Tasks"
                ],
                "summary": "Get task audit log history",
                "operationId": "get_api_task_get_audit_logs",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "string",
                            "format": "uuid",
                            "pattern": "[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Task audit log history",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/AuditLogCollectionResponseSchema"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Task not found"
                    },
                    "403": {
                        "description": "Access denied"
                    },
                    "401": {
                        "$ref": "#/components/responses/UnauthorizedError"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "RegisterDTO": {
                "required": [
                    "email",
                    "password"
                ],
                "properties": {
                    "email": {
                        "type": "string",
                        "format": "email",
                        "maxLength": 180,
                        "example": "user@example.com"
                    },
                    "password": {
                        "type": "string",
                        "maxLength": 100,
                        "minLength": 8,
                        "example": "secret123"
                    }
                },
                "type": "object"
            },
            "PageQueryDTO": {
                "properties": {
                    "number": {
                        "type": "integer",
                        "default": 1,
                        "minimum": 1
                    },
                    "size": {
                        "type": "integer",
                        "default": 20,
                        "maximum": 100,
                        "minimum": 1
                    }
                },
                "type": "object"
            },
            "TaskFilterDTO": {
                "properties": {
                    "status": {
                        "type": "string",
                        "default": null,
                        "enum": [
                            "todo",
                            "in_progress",
                            "completed",
                            "cancelled"
                        ],
                        "nullable": true
                    },
                    "due_from": {
                        "type": "string",
                        "default": null,
                        "nullable": true
                    },
                    "due_to": {
                        "type": "string",
                        "default": null,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TaskListQueryDTO": {
                "properties": {
                    "page": {
                        "$ref": "#/components/schemas/PageQueryDTO"
                    },
                    "sort": {
                        "type": "string",
                        "default": "created_at",
                        "enum": [
                            "created_at",
                            "status",
                            "due_date"
                        ]
                    },
                    "direction": {
                        "type": "string",
                        "default": "desc",
                        "enum": [
                            "asc",
                            "desc"
                        ]
                    },
                    "filter": {
                        "$ref": "#/components/schemas/TaskFilterDTO"
                    },
                    "search": {
                        "type": "string",
                        "default": null,
                        "maxLength": 100,
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TaskStatus": {
                "type": "string",
                "enum": [
                    "todo",
                    "in_progress",
                    "completed",
                    "cancelled"
                ]
            },
            "CreateTaskDTO": {
                "required": [
                    "title"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 255,
                        "example": "Buy milk"
                    },
                    "description": {
                        "type": "string",
                        "default": null,
                        "maxLength": 2000,
                        "minLength": 3,
                        "example": "2 liters",
                        "nullable": true
                    },
                    "status": {
                        "$ref": "#/components/schemas/TaskStatus"
                    },
                    "cancellation_reason": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 3,
                        "example": "Task is no longer relevant",
                        "nullable": true
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date",
                        "default": null,
                        "example": "2026-04-01",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UpdateTaskDTO": {
                "required": [
                    "title"
                ],
                "properties": {
                    "title": {
                        "type": "string",
                        "maxLength": 255,
                        "example": "Buy milk"
                    },
                    "description": {
                        "type": "string",
                        "default": null,
                        "maxLength": 2000,
                        "minLength": 3,
                        "example": "2 liters",
                        "nullable": true
                    },
                    "status": {
                        "$ref": "#/components/schemas/TaskStatus"
                    },
                    "cancellation_reason": {
                        "type": "string",
                        "maxLength": 500,
                        "minLength": 3,
                        "example": "Task is no longer needed",
                        "nullable": true
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date",
                        "default": null,
                        "example": "2026-04-01",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "UserResource": {
                "required": [
                    "type",
                    "id",
                    "attributes"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "example": "users"
                    },
                    "id": {
                        "type": "string",
                        "example": "1"
                    },
                    "attributes": {
                        "properties": {
                            "email": {
                                "type": "string",
                                "example": "user@example.com"
                            },
                            "created_at": {
                                "type": "string",
                                "format": "date-time"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "UserResponseSchema": {
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/UserResource"
                    }
                },
                "type": "object"
            },
            "PaginationLinksSchema": {
                "required": [
                    "first",
                    "last"
                ],
                "properties": {
                    "first": {
                        "type": "string",
                        "example": "/api/v1/tasks?page[number]=1&page[size]=20"
                    },
                    "last": {
                        "type": "string",
                        "example": "/api/v1/tasks?page[number]=8&page[size]=20"
                    },
                    "prev": {
                        "type": "string",
                        "example": "/api/v1/tasks?page[number]=1&page[size]=20",
                        "nullable": true
                    },
                    "next": {
                        "type": "string",
                        "example": "/api/v1/tasks?page[number]=2&page[size]=20",
                        "nullable": true
                    }
                },
                "type": "object"
            },
            "TaskResource": {
                "required": [
                    "type",
                    "id",
                    "attributes"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "example": "tasks"
                    },
                    "id": {
                        "type": "string",
                        "format": "uuid",
                        "example": "0195f2f7-1f0a-7db2-b6f6-5d1d48d6752b"
                    },
                    "attributes": {
                        "properties": {
                            "title": {
                                "type": "string",
                                "example": "Buy milk"
                            },
                            "description": {
                                "type": "string",
                                "example": "2 liters",
                                "nullable": true
                            },
                            "status": {
                                "$ref": "#/components/schemas/TaskStatus"
                            },
                            "cancellation_reason": {
                                "type": "string",
                                "example": "Task is no longer needed",
                                "nullable": true
                            },
                            "due_date": {
                                "type": "string",
                                "format": "date",
                                "nullable": true
                            },
                            "created_at": {
                                "type": "string",
                                "format": "date-time"
                            },
                            "updated_at": {
                                "type": "string",
                                "format": "date-time"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "PageMetaSchema": {
                "required": [
                    "current",
                    "size",
                    "total",
                    "last"
                ],
                "properties": {
                    "current": {
                        "type": "integer",
                        "example": 1
                    },
                    "size": {
                        "type": "integer",
                        "example": 20
                    },
                    "total": {
                        "type": "integer",
                        "example": 156
                    },
                    "last": {
                        "type": "integer",
                        "example": 8
                    }
                },
                "type": "object"
            },
            "PaginatedMetaSchema": {
                "required": [
                    "page"
                ],
                "properties": {
                    "page": {
                        "$ref": "#/components/schemas/PageMetaSchema"
                    }
                },
                "type": "object"
            },
            "TaskCollectionResponseSchema": {
                "required": [
                    "links",
                    "data",
                    "meta"
                ],
                "properties": {
                    "links": {
                        "$ref": "#/components/schemas/PaginationLinksSchema"
                    },
                    "data": {
                        "type": "array",
                        "items": {
                            "$ref": "#/components/schemas/TaskResource"
                        }
                    },
                    "meta": {
                        "$ref": "#/components/schemas/PaginatedMetaSchema"
                    }
                },
                "type": "object"
            },
            "TaskResponseSchema": {
                "required": [
                    "data"
                ],
                "properties": {
                    "data": {
                        "$ref": "#/components/schemas/TaskResource"
                    }
                },
                "type": "object"
            },
            "CollectionLinksSchema": {
                "required": [
                    "self"
                ],
                "properties": {
                    "self": {
                        "type": "string",
                        "example": "/api/v1/tasks/0195a6b4-6f15-7d4b-b2c1-05b2a3d6e7f8/audit-logs"
                    }
                },
                "type": "object"
            },
            "AuditLogResource": {
                "required": [
                    "type",
                    "id",
                    "attributes"
                ],
                "properties": {
                    "type": {
                        "type": "string",
                        "example": "audit_logs"
                    },
                    "id": {
                        "type": "string",
                        "example": "1"
                    },
                    "attributes": {
                        "properties": {
                            "entity_type": {
                                "type": "string",
                                "enum": [
                                    "task"
                                ],
                                "example": "task"
                            },
                            "entity_id": {
                                "type": "string",
                                "format": "uuid",
                                "example": "0195a6b4-6f15-7d4b-b2c1-05b2a3d6e7f8"
                            },
                            "user_id": {
                                "type": "integer",
                                "example": 7,
                                "nullable": true
                            },
                            "action": {
                                "type": "string",
                                "enum": [
                                    "created",
                                    "updated",
                                    "deleted"
                                ],
                                "example": "updated"
                            },
                            "message": {
                                "type": "string",
                                "example": "Updated task title for \"Buy almond milk\""
                            },
                            "attribute_changes": {
                                "properties": {
                                    "old": {
                                        "type": "object",
                                        "example": {
                                            "title": "Buy milk"
                                        },
                                        "additionalProperties": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    },
                                    "attributes": {
                                        "type": "object",
                                        "example": {
                                            "title": "Buy almond milk"
                                        },
                                        "additionalProperties": {
                                            "type": "string",
                                            "nullable": true
                                        }
                                    }
                                },
                                "type": "object",
                                "nullable": true
                            },
                            "properties": {
                                "type": "object",
                                "example": {
                                    "attributes": {
                                        "title": "Buy milk",
                                        "status": "todo"
                                    }
                                },
                                "nullable": true,
                                "additionalProperties": {}
                            },
                            "created_at": {
                                "type": "string",
                                "format": "date-time"
                            }
                        },
                        "type": "object"
                    }
                },
                "type": "object"
            },
            "AuditLogCollectionResponseSchema": {
                "required": [
                    "links",
                    "data"
                ],
                "properties": {
                    "links": {
                        "$ref": "#/components/schemas/CollectionLinksSchema"
                    },
